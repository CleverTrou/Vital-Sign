#!/usr/bin/env bash
# Launched via `open -a VitalSignBridge.app` from Advanced Scene Switcher's
# Run action, instead of running start_bridge.sh directly.
#
# Why this exists: when OBS spawns a Bluetooth-touching process directly (as
# a subprocess -- which is what Advanced Scene Switcher's Run action does),
# macOS's TCC privacy system holds OBS "responsible" for that Bluetooth
# access. OBS.app's own Info.plist has no NSBluetoothAlwaysUsageDescription
# (it doesn't need one for its own normal operation), so TCC can't even show
# a permission prompt and hard-crashes the process instead -- this is not a
# bug in bridge.py, see the crash report's "Responsible: OBS" line and
# "Namespace TCC" termination reason.
#
# `open -a` launches this app through LaunchServices as its own independent,
# top-level process rather than a direct child of whatever called `open` --
# so THIS bundle's Info.plist (which does declare Bluetooth usage) is what
# TCC evaluates instead of OBS's. Everything this script spawns inherits
# that identity.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

"$DIR/start_bridge.sh"
status=$?

# Double-clicking this app (from Finder, the Dock or Spotlight) should show
# the control window rather than do nothing. OBS reaches this same app
# through `open -a`, which looks identical from in here except for who
# launched it: LaunchServices records the launching app as LSParentASN, and
# for `open` that is never Finder, the Dock or Spotlight. So the window
# opens only for a person, and OBS's starts stay headless.
launched_by_a_person() {
  local parent id asn
  parent=$(lsappinfo info -only LSParentASN "$$" 2>/dev/null | grep -o 'ASN:0x[0-9a-fA-F]*-0x[0-9a-fA-F]*' | head -1)
  [[ -n "$parent" ]] || return 1
  for id in com.apple.finder com.apple.dock com.apple.Spotlight; do
    asn=$(lsappinfo find "bundleid=$id" 2>/dev/null | grep -o 'ASN:0x[0-9a-fA-F]*-0x[0-9a-fA-F]*' | head -1)
    [[ -n "$asn" && "$asn" == "$parent" ]] && return 0
  done
  return 1
}

if launched_by_a_person; then
  open "$DIR/Vital Sign.app"
fi
exit "$status"
