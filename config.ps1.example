# Optional local config for start_bridge.ps1 -- most people don't need this
# file at all. bridge.py auto-discovers your ring over BLE if you don't
# pin an address, which is fine as long as exactly one Viatom/Wellue/Checkme
# device is in range. Copy this file to config.ps1 only if you want to:
#   - skip the ~10s discovery scan on every start (faster reconnects), or
#   - pin a specific device because you own more than one
#
#   Copy-Item config.ps1.example config.ps1
#
# config.ps1 is gitignored on purpose: your BLE address identifies your
# specific physical device, so it doesn't belong in a repo others might
# fork, even though it isn't a secret in the password sense.
#
# Find your address with (after `pip install -r requirements.txt`):
#   .venv\Scripts\Activate.ps1; viatom-ble --scan-interactive
# $Address = "REPLACE_ME"

# Uncomment to use a non-default WebSocket port. If you do, also update
# WS_URL at the top of overlay.html's <script> to match.
# $WsPort = 8765
